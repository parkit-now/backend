# ================================================================
# PARKIT BACKEND — environment variables
# ================================================================
# For local development:  cp .env.example .env  and fill in the
# values printed by `supabase status`.
# Production values live only in CI/CD secrets — never commit a real
# .env file with real secrets.
# ================================================================


# ----------------------------------------------------------------
# ENV 1 — LOCAL (Supabase CLI / Docker)
# Prerequisite: `supabase start` (run from this repo's root).
# ----------------------------------------------------------------
# Pooled URL — used by Prisma at runtime (PrismaService).
DATABASE_URL="postgresql://postgres:postgres@localhost:54322/postgres"
# Direct URL — used by `prisma db push`, `supabase db diff` y `make push` (DDL / migraciones remotas).
DIRECT_URL="postgresql://postgres:postgres@localhost:54322/postgres"

SUPABASE_URL="http://localhost:54321"
SUPABASE_ANON_KEY="<paste 'Publishable' value from: supabase status>"
SUPABASE_SERVICE_ROLE_KEY="<paste 'Secret' value from: supabase status — NEVER ship to clients>"

# HS256 secret used by Supabase Auth to sign JWTs. The backend uses
# this to verify Authorization: Bearer <jwt> on every protected call.
# Get it from: supabase status  (field: 'JWT secret')
SUPABASE_JWT_SECRET="<from: supabase status>"

# OAuth providers for local Supabase Auth social login.
# Backend does NOT use these directly, but local Supabase reads them from env
# when `[auth.external.google]` / `[auth.external.github]` are enabled in
# `supabase/config.toml`.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID="<google oauth client id>"
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET="<google oauth client secret>"
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID="<github oauth client id>"
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET="<github oauth client secret>"
# Redirects expected by local Supabase Auth social login:
#   - Web:     http://127.0.0.1:3000
#   - Desktop: parkit://auth/callback

# LPR image retention job (src/lpr-events/lpr-image-retention.service.ts).
# "true" (default): only logs how many images WOULD be purged, deletes nothing.
# Set to "false" to enable real deletions after validating the dry-run counts.
LPR_IMAGE_RETENTION_DRY_RUN="true"

# API listen port. 3000 is the local-dev default; production sets PORT
# via the platform (fly.io, Railway, ECS, etc.).
PORT=3000


# ----------------------------------------------------------------
# Password recovery — Gmail SMTP (no domain required)
# ----------------------------------------------------------------
# Outbound email is sent through a dedicated Gmail account using an App
# Password (2FA must be enabled on that account to issue App Passwords).
# Swap providers (Resend/SES/...) by changing the `EmailSender` binding in
# `src/password-recovery/password-recovery.module.ts`.
GMAIL_SMTP_USER="parkit.notifications@gmail.com"
GMAIL_SMTP_APP_PASSWORD="<16-char app password — never commit>"
EMAIL_FROM="Parkit <parkit.notifications@gmail.com>"

# Web panel base URL the recovery link points to. Must be allow-listed in
# the Supabase dashboard under Auth → URL Configuration → Redirect URLs,
# otherwise `generateLink` rejects it.
WEB_PANEL_URL="http://localhost:5173"

# How long (minutes) we tell users the reset link stays valid. Display-only
# — actual expiration is enforced by Supabase Auth on the token itself.
PASSWORD_RESET_LINK_TTL_MIN=30


# ----------------------------------------------------------------
# Mercado Pago (src/mercado-pago/)
# ----------------------------------------------------------------
# Credenciales de la aplicación de Mercado Pago (panel de desarrolladores).
# `MpConfigService` las valida AL BOOT: si falta alguna, el backend NO LEVANTA.
# `MercadoPagoModule` ya está registrado en `app.module.ts`, así que estas
# variables son OBLIGATORIAS para correr local: las exige `make env-check`.
MP_CLIENT_ID="<application id — panel de MP>"
MP_CLIENT_SECRET="<client secret — panel de MP, nunca al cliente>"
# Debe ser HTTPS y coincidir EXACTO —carácter por carácter— con el redirect
# registrado en el panel de MP: Mercado Pago exige que sea una URL ESTÁTICA.
#
# 🔴 OJO: son DOS rutas distintas y se confunden todo el tiempo.
#   1. `redirect_uri` (ESTA variable) es una ruta del FRONT-WEB:
#      `/integraciones/mercadopago/callback`. Ahí Mercado Pago redirige el
#      NAVEGADOR del dueño con `?code=...&state=...`. Va el host del front.
#   2. El endpoint del BACKEND es otro: `POST /mercado-pago/oauth/callback`.
#      Ahí el panel POSTea esos dos parámetros con el bearer del usuario ya
#      logueado. NUNCA va en esta variable.
# Poner acá la ruta del backend hace que MP rechace la autorización con un
# error que no dice por qué.
MP_OAUTH_REDIRECT_URI="https://<host-del-front>/integraciones/mercadopago/callback"

# Clave ACTIVA para cifrar los tokens de OAuth antes de guardarlos
# (AES-256-GCM). 32 bytes en base64: openssl rand -base64 32
MP_TOKEN_ENCRYPTION_KEY="<openssl rand -base64 32>"
# Versión de la clave activa; se persiste en `mp_accounts.token_key_version`.
MP_TOKEN_ENCRYPTION_KEY_VERSION=1
# Claves anteriores, SOLO para descifrar filas viejas durante una rotación:
# "<versión>:<clave base64>" separadas por coma.
# MP_TOKEN_ENCRYPTION_KEY_PREVIOUS="1:<clave base64 anterior>"

# Secreto de firma de los webhooks. OPCIONAL a propósito: Mercado Pago lo
# genera recién cuando se registra la URL del webhook (etapa B4). Sin él la
# verificación de firma falla con un error explícito, pero el backend levanta.
# MP_WEBHOOK_SECRET="<clave secreta del webhook — panel de MP>"

# Base de la API de MP. Sólo para apuntar a un mock en pruebas manuales.
# MP_API_BASE_URL="https://api.mercadopago.com"


# ----------------------------------------------------------------
# ENV 2 — PR PREVIEW (Supabase Branching)
# Injected by GitHub Actions on every PR. Documented for reference,
# do NOT set by hand.
# ----------------------------------------------------------------
# DATABASE_URL="<injected by CI — ephemeral PR branch>"
# DIRECT_URL="<injected by CI — ephemeral PR branch>"
# SUPABASE_URL="<injected by CI>"
# SUPABASE_ANON_KEY="<injected by CI>"
# SUPABASE_SERVICE_ROLE_KEY="<injected by CI>"
# SUPABASE_JWT_SECRET="<injected by CI>"
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID="<injected by CI if used>"
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET="<injected by CI if used>"
# SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID="<injected by CI if used>"
# SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET="<injected by CI if used>"


# ----------------------------------------------------------------
# ENV 3 — PRODUCTION (merge to main)
# Configured in the deployment platform's secret store.
# ----------------------------------------------------------------
# DATABASE_URL="postgresql://postgres:[PWD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres:[PWD]@db.[REF].supabase.co:5432/postgres"
# SUPABASE_URL="https://[REF].supabase.co"
# SUPABASE_ANON_KEY="<dashboard → Settings → API>"
# SUPABASE_SERVICE_ROLE_KEY="<dashboard → Settings → API — NEVER ship to clients>"
# SUPABASE_JWT_SECRET="<dashboard → Settings → API — JWT Settings>"
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID="<google cloud oauth client id>"
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET="<google cloud oauth client secret>"
# SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID="<github oauth app client id>"
# SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET="<github oauth app client secret>"

# Mercado Pago — la aplicación de PRODUCCIÓN del panel de desarrolladores, no
# la de pruebas: son credenciales distintas y cobran plata de verdad.
# MP_CLIENT_ID="<application id — panel de MP, app de producción>"
# MP_CLIENT_SECRET="<client secret — panel de MP, nunca al cliente>"
# HTTPS y EXACTO al redirect registrado en MP (URL estática, apunta al front).
# Es la ruta del FRONT-WEB, NO el endpoint del backend
# (`POST /mercado-pago/oauth/callback`): ver la nota del bloque local.
# MP_OAUTH_REDIRECT_URI="https://<host-del-front>/integraciones/mercadopago/callback"
# Clave ACTIVA de cifrado de tokens (AES-256-GCM), 32 bytes en base64.
# NUNCA la misma que en local: con la clave de local, un dump de prod se lee.
# MP_TOKEN_ENCRYPTION_KEY="<openssl rand -base64 32>"
# Versión de la clave activa; se persiste en `mp_accounts.token_key_version`.
# MP_TOKEN_ENCRYPTION_KEY_VERSION="1"
# Claves anteriores, SOLO para descifrar durante una rotación: "<v>:<base64>".
# MP_TOKEN_ENCRYPTION_KEY_PREVIOUS="1:<clave base64 anterior>"
# Secreto de firma de webhooks. Lo genera MP al registrar la URL (etapa B4).
# MP_WEBHOOK_SECRET="<clave secreta del webhook — panel de MP>"
