# ================================================================
# PARKIT BACKEND — environment variables
# ================================================================
# For local development:  cp .env.example .env  and fill in the
# values printed by `supabase status`.
# Production values live only in CI/CD secrets — never commit a real
# .env file with real secrets.
# ================================================================


# ----------------------------------------------------------------
# ENV 1 — LOCAL (Supabase CLI / Docker)
# Prerequisite: `supabase start` (run from this repo's root).
# ----------------------------------------------------------------
# Pooled URL — used by Prisma at runtime (PrismaService).
DATABASE_URL="postgresql://postgres:postgres@localhost:54322/postgres"
# Direct URL — used by `prisma db push` and `supabase db diff` (DDL).
DIRECT_URL="postgresql://postgres:postgres@localhost:54322/postgres"

SUPABASE_URL="http://localhost:54321"
SUPABASE_ANON_KEY="<paste 'Publishable' value from: supabase status>"
SUPABASE_SERVICE_ROLE_KEY="<paste 'Secret' value from: supabase status — NEVER ship to clients>"

# HS256 secret used by Supabase Auth to sign JWTs. The backend uses
# this to verify Authorization: Bearer <jwt> on every protected call.
# Get it from: supabase status  (field: 'JWT secret')
SUPABASE_JWT_SECRET="<from: supabase status>"

# API listen port. 3000 is the local-dev default; production sets PORT
# via the platform (fly.io, Railway, ECS, etc.).
PORT=3000


# ----------------------------------------------------------------
# ENV 2 — PR PREVIEW (Supabase Branching)
# Injected by GitHub Actions on every PR. Documented for reference,
# do NOT set by hand.
# ----------------------------------------------------------------
# DATABASE_URL="<injected by CI — ephemeral PR branch>"
# DIRECT_URL="<injected by CI — ephemeral PR branch>"
# SUPABASE_URL="<injected by CI>"
# SUPABASE_ANON_KEY="<injected by CI>"
# SUPABASE_SERVICE_ROLE_KEY="<injected by CI>"
# SUPABASE_JWT_SECRET="<injected by CI>"


# ----------------------------------------------------------------
# ENV 3 — PRODUCTION (merge to main)
# Configured in the deployment platform's secret store.
# ----------------------------------------------------------------
# DATABASE_URL="postgresql://postgres:[PWD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres:[PWD]@db.[REF].supabase.co:5432/postgres"
# SUPABASE_URL="https://[REF].supabase.co"
# SUPABASE_ANON_KEY="<dashboard → Settings → API>"
# SUPABASE_SERVICE_ROLE_KEY="<dashboard → Settings → API — NEVER ship to clients>"
# SUPABASE_JWT_SECRET="<dashboard → Settings → API — JWT Settings>"
