// Reserva de un conductor en una playa (migración 20261002231000).
//
// El `id` lo manda el cliente: es la clave de idempotencia del POST. Patente,
// tarifa y total son SNAPSHOTS (registro histórico).
// Ciclo de vida completo desde la migración 20261004120000: nace en
// pending_payment (retención de 10 min), pasa a pending_approval o confirmed
// según el modo de aceptación, y termina en completed / cancelled / rejected /
// expired / no_show. Backend-only: RLS sin policies.

enum ReservationStatus {
  pending_payment
  pending_approval
  confirmed
  checked_in
  completed
  cancelled
  rejected
  expired
  no_show

  @@map("reservation_status")
}

model Reservation {
  id                               String            @id @db.Uuid
  vehiclePlate                     String            @map("vehicle_plate") @db.VarChar(10)
  entryAt                          DateTime          @map("entry_at") @db.Timestamptz(6)
  exitAt                           DateTime          @map("exit_at") @db.Timestamptz(6)
  totalArs                         Decimal           @map("total_ars") @db.Decimal(12, 2)
  rateSnapshotName                 String            @map("rate_snapshot_name") @db.VarChar(120)
  rateSnapshotHourPriceArs         Decimal           @map("rate_snapshot_hour_price_ars") @db.Decimal(12, 2)
  // Foto completa de la tarifa (migración 20261003120000), para el excedente.
  // NULL en las reservas anteriores.
  rateSnapshotFractionPriceArs     Decimal?          @map("rate_snapshot_fraction_price_ars") @db.Decimal(12, 2)
  rateSnapshotMediaEstadiaPriceArs Decimal?          @map("rate_snapshot_media_estadia_price_ars") @db.Decimal(12, 2)
  rateSnapshotStayPriceArs         Decimal?          @map("rate_snapshot_stay_price_ars") @db.Decimal(12, 2)
  status                           ReservationStatus @default(confirmed)
  cancelledAt                      DateTime?         @map("cancelled_at") @db.Timestamptz(6)
  // Retención y pago.
  holdExpiresAt                    DateTime?         @map("hold_expires_at") @db.Timestamptz(6)
  paidAt                           DateTime?         @map("paid_at") @db.Timestamptz(6)
  // Modo manual: hasta cuándo puede responder el dueño.
  approvalDeadlineAt               DateTime?         @map("approval_deadline_at") @db.Timestamptz(6)
  // Quién canceló o rechazó y por qué. `cancelledBy` es el LADO: driver | owner
  // | system, donde `owner` significa "el estacionamiento" (dueño u operador).
  // La persona concreta está en `cancelledByUserId` (null si fue el sistema) y
  // su rol, en la auditoría (`audit_log.metadata.actorRole`).
  cancelledBy                      String?           @map("cancelled_by")
  cancelledByUserId                String?           @map("cancelled_by_user_id") @db.Uuid
  reason                           String?
  // Reembolso: none | pending | refunded | partial | failed.
  refundStatus                     String            @default("none") @map("refund_status")
  refundedAmountArs                Decimal?          @map("refunded_amount_ars") @db.Decimal(12, 2)
  refundError                      String?           @map("refund_error")
  refundRequestedAt                DateTime?         @map("refund_requested_at") @db.Timestamptz(6)
  // Monto del último reembolso pedido (el reintento de un `failed` lo reusa).
  refundRequestedArs               Decimal?          @map("refund_requested_ars") @db.Decimal(12, 2)
  refundAttempts                   Int               @default(0) @map("refund_attempts")
  // Reglas de la playa al reservar (ver reservation-policy.ts).
  policySnapshot                   Json?             @map("policy_snapshot")
  // Categoría del vehículo del conductor al reservar (snapshot, migración
  // 20261005120300). NULL en las reservas anteriores.
  vehicleCategory                  String?           @map("vehicle_category") @db.VarChar(20)
  createdAt                        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                        DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)

  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId   String @map("user_id") @db.Uuid
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Migración 20261004130000: `ON DELETE SET NULL`.
  cancelledByUser User? @relation("ReservationCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)

  vehicleCategoryRef VehicleCategory? @relation(fields: [vehicleCategory], references: [code], onUpdate: Cascade, map: "reservations_vehicle_category_fkey")

  payments ReservationPayment[]
  // Ingreso de la caja vinculado (migración 20261006120000).
  entry    Entry?

  // Índices parciales sólo en SQL: `reservations_tenant_window_idx`
  // (cupo, WHERE status retiene lugar).
  @@index([userId, entryAt(sort: Desc)], map: "reservations_user_entry_idx")
  @@index([tenantId, status, entryAt], map: "reservations_tenant_status_entry_idx")
  @@index([status, holdExpiresAt], map: "reservations_status_hold_idx")
  @@map("reservations")
}
