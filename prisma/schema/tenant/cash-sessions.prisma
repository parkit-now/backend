model CashSession {
  // UUIDv7 is generated by the desktop client to support offline-first writes.
  id String @id @db.Uuid

  openedAt    DateTime  @default(now()) @map("opened_at") @db.Timestamptz(6)
  closedAt    DateTime? @map("closed_at") @db.Timestamptz(6)
  openingCash Decimal   @default(0) @map("opening_cash") @db.Decimal(12, 2)
  leavingCash Decimal?  @map("leaving_cash") @db.Decimal(12, 2)
  notes       String?   @db.Text

  version   Int      @default(1)
  syncSeq   Int      @default(dbgenerated("nextval('cash_sessions_sync_seq')")) @map("sync_seq")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  entries             Entry[]
  paymentTransactions PaymentTransaction[]

  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId], map: "cash_sessions_tenant_id_idx")
  @@index([tenantId, syncSeq], map: "cash_sessions_tenant_sync_seq_idx")
  @@index([tenantId, updatedAt], map: "cash_sessions_tenant_updated_at_idx")
  @@map("cash_sessions")
}
