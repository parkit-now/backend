// Service — toggle por tenant de una prestación conocida. El catálogo completo
// vive en el enum ServiceCode; existe una fila sólo para los códigos que el
// tenant tocó, así que el GET mergea los defaults del enum (deshabilitados) con
// las filas guardadas. Tenant-local + campos de sync, espejando Rate.
//
// Los códigos VEHICLE_* y la columna `spots` se retiraron: las plazas son una
// capacidad general (`tenant.settings.capacity.total`) y "qué vehículos acepta
// la playa" vive en `vehicle_types.accepted`. Eran tres taxonomías desalineadas
// para una sola pregunta.

model Service {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      ServiceCode
  enabled   Boolean     @default(false)
  version   Int         @default(1)
  syncSeq   Int         @default(dbgenerated("nextval('services_sync_seq')")) @map("sync_seq")
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Configuración de ADVANCE_RESERVATION (migración 20261002230000, SCRUM-214):
  // la tarifa con la que se cobran las reservas, sin distinción de vehículo, y
  // cuántas plazas se pueden reservar a la vez. NULL = sin configurar; un CHECK
  // las prohíbe en otros códigos. FK COMPUESTA como en Vehicle; el ON DELETE
  // SET NULL (reservation_rate_id) vive sólo en el SQL.
  reservationRateId String? @map("reservation_rate_id") @db.Uuid
  reservationRate   Rate?   @relation(fields: [tenantId, reservationRateId], references: [tenantId, id], map: "services_tenant_reservation_rate_fkey")
  reservableSpots   Int?    @map("reservable_spots")

  // Reglas de ADVANCE_RESERVATION (migración 20261003120000). Los defaults son
  // los del producto; la API sólo los deja tocar en ese código.
  // `reservationVehicleCategories` ⊆ car | suv | pickup | van | motorcycle (las
  // reservables; CHECK en SQL, migración 20261005120300). Antes `kinds`.
  reservationVehicleCategories String[] @default([]) @map("reservation_vehicle_categories")
  // opening = horario de apertura; custom = filas de `reservation_hours`.
  reservationHoursMode    String   @default("opening") @map("reservation_hours_mode")
  // auto | manual.
  acceptanceMode          String   @default("auto") @map("acceptance_mode")
  approvalWindowMinutes   Int      @default(15) @map("approval_window_minutes")
  freeCancelMinutes       Int      @default(60) @map("free_cancel_minutes")
  lateCancelRefundPct     Int      @default(0) @map("late_cancel_refund_pct")
  earlyArrivalMinutes     Int      @default(15) @map("early_arrival_minutes")
  graceMinutes            Int      @default(30) @map("grace_minutes")
  // Tope de la llegada anticipada (migración 20261007120000): hasta cuántos
  // minutos antes de `entryAt` el ingreso se vincula solo ("llegó antes", el
  // extra se cobra como excedente). Antes de eso, estadía común.
  earlyArrivalMaxMinutes  Int      @default(60) @map("early_arrival_max_minutes")

  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code], map: "services_tenant_code_unique")
  @@index([tenantId], map: "services_tenant_id_idx")
  @@index([tenantId, syncSeq], map: "services_tenant_sync_seq_idx")
  @@index([tenantId, updatedAt], map: "services_tenant_updated_at_idx")
  @@map("services")
}

enum ServiceCode {
  ADVANCE_RESERVATION

  @@map("service_code")
}
