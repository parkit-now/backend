model Rate {
  // UUIDv7 is generated by the desktop app to support offline-first writes.
  id String @id @db.Uuid

  name            String  @db.VarChar(120)
  hourPriceArs    Decimal @map("hour_price_ars") @db.Decimal(12, 2)
  stayPriceArs    Decimal @map("stay_price_ars") @db.Decimal(12, 2)
  fractionPriceArs Decimal @map("fraction_price_ars") @db.Decimal(12, 2)
  // Tope de las 12h. 0 = la tarifa no tiene este escalón, no que sea gratis.
  mediaEstadiaPriceArs Decimal @default(0) @map("media_estadia_price_ars") @db.Decimal(12, 2)
  // Preferencia de UI: la fracción se deriva de hora / 12 (techo legal). El
  // valor derivado se guarda igual en fractionPriceArs; el cobro no lee esto.
  autoFractionPrice Boolean @default(false) @map("auto_fraction_price")
  isActive        Boolean @default(true) @map("is_active")
  shortcutNumber  Int?    @map("shortcut_number")
  version         Int     @default(1)
  syncSeq         Int     @default(dbgenerated("nextval('rates_sync_seq')")) @map("sync_seq")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Soft delete: the row survives marked so the deletion travels through
  // /rates/changes as a tombstone. The partial unique index on
  // (tenant_id, shortcut_number) is scoped to deleted_at IS NULL in SQL —
  // Prisma cannot express a partial index, so it lives only in the migration.
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  entries Entry[]
  // Servicio de reservas que la usa para cobrarlas (services.reservation_rate_id).
  reservationServices Service[]

  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  // Destino de FKs compuestas (services.reservation_rate_id): impide apuntar a
  // la tarifa de otro tenant.
  @@unique([tenantId, id], map: "rates_tenant_id_id_key")
  @@index([tenantId], map: "rates_tenant_id_idx")
  @@index([tenantId, syncSeq], map: "rates_tenant_sync_seq_idx")
  @@index([tenantId, updatedAt], map: "rates_tenant_updated_at_idx")
  @@map("rates")
}
