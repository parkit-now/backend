model Rate {
  // UUIDv7 is generated by the desktop app to support offline-first writes.
  id String @id @db.Uuid

  name            String  @db.VarChar(120)
  hourPriceArs    Decimal @map("hour_price_ars") @db.Decimal(12, 2)
  stayPriceArs    Decimal @map("stay_price_ars") @db.Decimal(12, 2)
  fractionPriceArs Decimal @map("fraction_price_ars") @db.Decimal(12, 2)
  isActive        Boolean @default(true) @map("is_active")
  version         Int     @default(1)
  syncSeq         Int     @default(0) @map("sync_seq")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId], map: "rates_tenant_id_idx")
  @@index([tenantId, syncSeq], map: "rates_tenant_sync_seq_idx")
  @@index([tenantId, updatedAt], map: "rates_tenant_updated_at_idx")
  @@map("rates")
}
