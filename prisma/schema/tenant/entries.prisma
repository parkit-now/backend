model Entry {
  // UUIDv7 is generated by the desktop client to support offline-first writes.
  id        String @id @db.Uuid

  plate      String    @db.VarChar(20)
  color      String?   @db.VarChar(50)
  cochera    String?   @db.VarChar(100)
  notes      String?   @db.Text
  enteredAt  DateTime  @default(now()) @map("entered_at")
  leftAt     DateTime? @map("left_at")
  amountPaid Decimal?  @map("amount_paid") @db.Decimal(10, 2)

  // LPR fields — populated on automatic ingress; null for manual entries.
  source         String      @default("manual") @db.VarChar(10)
  vehicleType    VehicleType? @map("vehicle_type")
  entryImageUrl  String?     @map("entry_image_url")
  entryCameraId  String?     @map("entry_camera_id") @db.VarChar(100)
  exitImageUrl   String?     @map("exit_image_url")
  exitCameraId   String?     @map("exit_camera_id") @db.VarChar(100)

  version   Int      @default(1)
  syncSeq   Int      @default(dbgenerated("nextval('entries_sync_seq')")) @map("sync_seq")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Rate snapshot — captured at entry creation, immutable afterwards.
  rateId                       String?  @map("rate_id") @db.Uuid
  rateSnapshotName             String?  @map("rate_snapshot_name") @db.VarChar(120)
  rateSnapshotHourPriceArs     Decimal? @map("rate_snapshot_hour_price_ars") @db.Decimal(12, 2)
  rateSnapshotStayPriceArs     Decimal? @map("rate_snapshot_stay_price_ars") @db.Decimal(12, 2)
  rateSnapshotFractionPriceArs Decimal? @map("rate_snapshot_fraction_price_ars") @db.Decimal(12, 2)

  vehicleBrand String? @map("vehicle_brand") @db.VarChar(120)
  vehicleModel String? @map("vehicle_model") @db.VarChar(120)

  cashSessionId String? @map("cash_session_id") @db.Uuid
  ticketNumber  Int?    @map("ticket_number")

  whitelistId String?    @map("whitelist_id") @db.Uuid
  whitelist   Whitelist? @relation(fields: [whitelistId], references: [id], onDelete: SetNull, map: "entries_whitelist_id_fkey")

  rate        Rate?        @relation(fields: [rateId], references: [id], onDelete: SetNull, map: "entries_rate_id_fkey")
  cashSession CashSession? @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)

  paymentTransactions PaymentTransaction[]
  lprDetectionEvents  LprDetectionEvent[]

  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId], map: "entries_tenant_id_idx")
  @@index([tenantId, syncSeq], map: "entries_tenant_sync_seq_idx")
  @@index([tenantId, updatedAt], map: "entries_tenant_updated_at_idx")
  @@index([tenantId, cashSessionId], map: "entries_tenant_cash_session_idx")
  @@map("entries")
}
