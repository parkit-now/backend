model Entry {
  // UUIDv7 is generated by the desktop client to support offline-first writes.
  id        String @id @db.Uuid

  plate      String    @db.VarChar(20)
  color      String?   @db.VarChar(50)
  cochera    String?   @db.VarChar(100)
  notes      String?   @db.Text
  enteredAt  DateTime  @default(now()) @map("entered_at")
  leftAt     DateTime? @map("left_at")
  amountPaid Decimal?  @map("amount_paid") @db.Decimal(10, 2)
  /// Checkbox "Facturada" para las playas sin integración con ARCA.
  manuallyInvoiced Boolean @default(false) @map("manually_invoiced")

  // LPR fields — populated on automatic ingress; null for manual entries.
  source         String      @default("manual") @db.VarChar(10)
  // Snapshot de texto, igual que vehicleBrand/vehicleModel: un ingreso
  // histórico no debe cambiar si el dueño renombra o borra el tipo.
  vehicleType    String?     @map("vehicle_type") @db.VarChar(60)
  // Tipo elegido al ingresar. SIN FK a propósito (migración 20261005120200): una
  // caja sin conexión puede referenciar un tipo que el dueño borró mientras
  // tanto, y no hay que perder un ingreso con plata por eso.
  vehicleTypeId  String?     @map("vehicle_type_id") @db.Uuid
  // Categoría de la plataforma, congelada al ingresar: si el dueño cambia la
  // categoría de un tipo, los ingresos ya hechos conservan la que guardaron.
  vehicleCategory    String?          @map("vehicle_category") @db.VarChar(20)
  vehicleCategoryRef VehicleCategory? @relation(fields: [vehicleCategory], references: [code], onUpdate: Cascade, map: "entries_vehicle_category_fkey")
  entryImageUrl  String?     @map("entry_image_url")
  entryCameraId  String?     @map("entry_camera_id") @db.VarChar(100)
  exitImageUrl   String?     @map("exit_image_url")
  exitCameraId   String?     @map("exit_camera_id") @db.VarChar(100)

  version   Int      @default(1)
  syncSeq   Int      @default(dbgenerated("nextval('entries_sync_seq')")) @map("sync_seq")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Snapshot de tarifa — se congela al ingresar.
  //
  // Ninguna edición de tarifa lo mueve por sí sola. Hay exactamente DOS formas
  // de reescribirlo, las dos con una persona decidiendo: corregir la estadía y
  // elegir otra tarifa (`correctEntry`), o que el dueño edite los PRECIOS y
  // responda que sí a pasar los autos que están adentro (`updateRate` con
  // `applyToOpenEntries`). Las estadías ya cerradas no se tocan nunca.
  //
  // El cobro sale SIEMPRE de acá, nunca de releer la tarifa viva.
  rateId                       String?  @map("rate_id") @db.Uuid
  rateSnapshotName             String?  @map("rate_snapshot_name") @db.VarChar(120)
  rateSnapshotHourPriceArs     Decimal? @map("rate_snapshot_hour_price_ars") @db.Decimal(12, 2)
  rateSnapshotStayPriceArs     Decimal? @map("rate_snapshot_stay_price_ars") @db.Decimal(12, 2)
  rateSnapshotFractionPriceArs Decimal? @map("rate_snapshot_fraction_price_ars") @db.Decimal(12, 2)
  // NULL = la tarifa vigente al ingresar no tenía escalón de media estadía.
  rateSnapshotMediaEstadiaPriceArs Decimal? @map("rate_snapshot_media_estadia_price_ars") @db.Decimal(12, 2)

  vehicleBrand String? @map("vehicle_brand") @db.VarChar(120)
  vehicleModel String? @map("vehicle_model") @db.VarChar(120)

  cashSessionId String? @map("cash_session_id") @db.Uuid
  ticketNumber  Int?    @map("ticket_number")

  // Reserva con la que entró el auto (migración 20261006120000). La escribe el
  // backend al crear el ingreso: por `reservationId` o por patente. A lo sumo
  // un ingreso por reserva (UNIQUE; los NULL no chocan).
  reservationId    String?      @unique(map: "entries_reservation_id_key") @map("reservation_id") @db.Uuid
  reservation      Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull, map: "entries_reservation_id_fkey")
  // Lo que el conductor pagó por adelantado (snapshot al vincular). La caja
  // cobra `max(calcStayPrice(total) − prepaidAmountArs, 0)`.
  prepaidAmountArs Decimal?     @map("prepaid_amount_ars") @db.Decimal(12, 2)

  whitelistId String?    @map("whitelist_id") @db.Uuid
  whitelist   Whitelist? @relation(fields: [whitelistId], references: [id], onDelete: SetNull, map: "entries_whitelist_id_fkey")

  rate        Rate?        @relation(fields: [rateId], references: [id], onDelete: SetNull, map: "entries_rate_id_fkey")
  cashSession CashSession? @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)

  paymentTransactions PaymentTransaction[]
  invoice             Invoice?
  lprDetectionEvents  LprDetectionEvent[]
  // Intentos de cobro con QR de Mercado Pago (global/payment-intents.prisma).
  // Es una lista, pero a lo sumo UNO puede estar vivo a la vez: lo garantiza el
  // índice único parcial `payment_intents_entry_live_idx`, que es lo que evita
  // el doble cobro de la misma estadía.
  paymentIntents      PaymentIntent[]

  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId], map: "entries_tenant_id_idx")
  @@index([tenantId, syncSeq], map: "entries_tenant_sync_seq_idx")
  @@index([tenantId, updatedAt], map: "entries_tenant_updated_at_idx")
  @@index([tenantId, cashSessionId], map: "entries_tenant_cash_session_idx")
  // Metrics dashboard: revenue is filtered by exit time, the "entered" series
  // by arrival time, and top-plates groups closed stays by plate.
  @@index([tenantId, leftAt], map: "entries_tenant_left_at_idx")
  @@index([tenantId, enteredAt], map: "entries_tenant_entered_at_idx")
  @@index([tenantId, plate], map: "entries_tenant_plate_idx")
  @@map("entries")
}
