// Zone — TENANT-LOCAL table: spot counts per vehicle type in a lot.
//
// Counts only (car/motorcycle/bicycle); the individual spot is operational and
// out of scope. Isolated per tenant like Entry: register 'zone' in
// TENANT_MODELS (src/database/prisma-tenant.ts) and use getTenantClient().

model Zone {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  carSpots        Int      @default(0) @map("car_spots")
  motorcycleSpots Int      @default(0) @map("motorcycle_spots")
  bicycleSpots    Int      @default(0) @map("bicycle_spots")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("zones")
}
