model PaymentTransaction {
  // UUIDv7 is generated by the desktop client to support offline-first writes.
  id String @id @db.Uuid

  // El par `paymentMethodId` / `paymentMethodName` es un SNAPSHOT: el medio se
  // puede renombrar o borrar (por eso el id es nullable y no hay FK) y el
  // comprobante histórico tiene que seguir diciendo lo que decía.
  paymentMethodId   String?  @map("payment_method_id") @db.Uuid
  paymentMethodName String   @map("payment_method_name") @db.VarChar(120)

  // Tercer campo del mismo snapshot, y el que usa el arqueo de caja para
  // decidir qué plata entró al cajón (`cash`). Antes eso se adivinaba
  // buscando "efectivo" en el nombre, lo que rompía el arqueo de cualquier
  // dueño que renombrara su método a "Caja" y contaba como efectivo a un
  // "Efectivo Mercado Pago" que nunca lo fue.
  // NOT NULL y sin DEFAULT a propósito: ver
  // 20260913200901_payment_transactions_method_type_snapshot.sql.
  paymentMethodType PaymentMethodType @map("payment_method_type")

  amount            Decimal  @db.Decimal(12, 2)

  version   Int      @default(1)
  syncSeq   Int      @default(dbgenerated("nextval('payment_transactions_sync_seq')")) @map("sync_seq")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  entryId       String  @map("entry_id") @db.Uuid
  entry         Entry   @relation(fields: [entryId], references: [id])

  cashSessionId String?      @map("cash_session_id") @db.Uuid
  cashSession   CashSession? @relation(fields: [cashSessionId], references: [id])

  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@index([entryId], map: "payment_transactions_entry_id_idx")
  @@index([tenantId], map: "payment_transactions_tenant_id_idx")
  @@index([tenantId, syncSeq], map: "payment_transactions_tenant_sync_seq_idx")
  @@index([tenantId, cashSessionId], map: "payment_transactions_tenant_session_idx")
  @@map("payment_transactions")
}
