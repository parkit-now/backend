// UserMembership — N:M between User and Tenant (entity), carrying the
// per-entity role.
//
// A row means: this user is linked to this entity with a role:
//   - owner    → full management of the entity (profile, rates, payment
//                methods, zones, personal).
//   - operator → operational only (register entries/exits, view rates/data).
//
// The GLOBAL role (User.role, see auth.prisma) is only admin|user; `admin`
// bypasses membership checks entirely. The entity-level role lives HERE, not in
// the JWT: it is read per request by `TenantMembershipGuard` and checked by the
// centralized `PermissionsService`. The desktop may cache it for offline authz.

enum MembershipRole {
  owner
  operator

  @@map("membership_role")
}

model UserMembership {
  userId    String         @map("user_id") @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  role      MembershipRole
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([userId, tenantId])
  @@index([tenantId])
  @@map("user_memberships")
}
