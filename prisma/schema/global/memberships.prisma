// UserMembership — N:M between User and Tenant.
//
// A row means: this user is associated with this tenant (= parking lot). The
// role is global on `User` (see auth.prisma); membership only carries the
// link.
//
// Cardinality invariants (enforced in application code, not by the DB):
//   - role=owner    → 0..N memberships (one per lot they run).
//   - role=operator → 0..N memberships (one per lot they work in).
//   - role=driver / role=admin → always 0 memberships.
//
// The "active" tenant for a session is carried in the JWT
// (`app_metadata.tenant_id`) and matched against this table on login /
// switch-tenant flows.

model UserMembership {
  userId    String   @map("user_id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([userId, tenantId])
  @@index([tenantId])
  @@map("user_memberships")
}
