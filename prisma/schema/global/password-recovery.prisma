// Password recovery — audit trail of reset requests.
//
// Stores one row per attempt to reset a password, regardless of outcome
// (mail sent, unknown email, rate-limited, send failure, completed).
//
// The recovery TOKEN itself never lives here — it is generated and validated
// by Supabase Auth (`generateLink` / `verifyOtp`), which already guarantees
// expiration and single-use. This table only enables rate-limiting and
// post-hoc visibility ("did the user actually receive the mail?").
//
// Backend-only: service-role writes, no RLS policies declared.

model PasswordResetRequest {
  id          String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email       String                     @db.VarChar(255)
  ipAddress   String?                    @map("ip_address") @db.VarChar(64)
  status      PasswordResetRequestStatus
  requestedAt DateTime                   @default(now()) @map("requested_at") @db.Timestamptz(6)
  completedAt DateTime?                  @map("completed_at") @db.Timestamptz(6)

  @@index([email, requestedAt])
  @@map("password_reset_requests")
}

enum PasswordResetRequestStatus {
  sent
  email_failed
  ignored_unknown_email
  ignored_rate_limited
  completed

  @@map("password_reset_request_status")
}
