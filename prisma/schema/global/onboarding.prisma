// Onboarding — a company's onboarding application and its documentation.
//
// A company can accumulate several applications (rejection -> resubmit). The
// declared branches are stored in `declaredBranches` (jsonb) until, on
// approval, they are materialized as rows in `tenants`.
//
// Backend-only: service-role, RLS without policies.

enum ApplicationStatus {
  draft
  pending_review
  approved
  rejected

  @@map("application_status")
}

model OnboardingApplication {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status           ApplicationStatus @default(draft)
  declaredBranches Json              @default("[]") @map("declared_branches")
  submittedAt      DateTime?         @map("submitted_at") @db.Timestamptz(6)
  reviewedAt       DateTime?         @map("reviewed_at") @db.Timestamptz(6)
  rejectionReason  String?           @map("rejection_reason")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  reviewedBy String? @map("reviewed_by") @db.Uuid
  reviewer   User?   @relation(fields: [reviewedBy], references: [id])

  documents CompanyDocument[]

  @@index([companyId])
  @@index([status])
  @@map("onboarding_applications")
}

model CompanyDocument {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  storagePath String   @map("storage_path")
  mimeType    String?  @map("mime_type")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  applicationId String?                @map("application_id") @db.Uuid
  application   OnboardingApplication? @relation(fields: [applicationId], references: [id])

  @@index([companyId])
  @@index([applicationId])
  @@map("company_documents")
}
