// Onboarding — a user's request to register ONE parking lot (entity).
//
// There is no company grouping: an application belongs directly to the
// applicant (`applicant_user_id`) and declares a single entity in
// `declaredEntity` (jsonb: name, address, legalName, cuit, email, phone, spots).
// On approval the entity is materialized as a row in `tenants` and linked back
// via `tenant_id`. A user can submit several applications (one per lot, or
// resubmit after rejection).
//
// Backend-only: service-role, RLS without policies.

enum ApplicationStatus {
  draft
  pending_review
  approved
  rejected

  @@map("application_status")
}

model OnboardingApplication {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status          ApplicationStatus @default(draft)
  declaredEntity  Json              @default("{}") @map("declared_entity")
  submittedAt     DateTime?         @map("submitted_at") @db.Timestamptz(6)
  reviewedAt      DateTime?         @map("reviewed_at") @db.Timestamptz(6)
  rejectionReason String?           @map("rejection_reason")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  applicantUserId String @map("applicant_user_id") @db.Uuid
  applicant       User   @relation("ApplicantApplications", fields: [applicantUserId], references: [id], onDelete: Cascade)

  reviewedBy String? @map("reviewed_by") @db.Uuid
  reviewer   User?   @relation("ReviewedApplications", fields: [reviewedBy], references: [id])

  // The entity created on approval (null until approved).
  tenantId String? @map("tenant_id") @db.Uuid
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  documents ApplicationDocument[]

  @@index([applicantUserId])
  @@index([status])
  @@map("onboarding_applications")
}

model ApplicationDocument {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  storagePath String   @map("storage_path")
  mimeType    String?  @map("mime_type")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  applicationId String                @map("application_id") @db.Uuid
  application   OnboardingApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("application_documents")
}
