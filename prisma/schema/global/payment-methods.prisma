// PaymentMethod — company-level payment methods.
//
// On company approval, 'mp_transfer' and 'cash' are created automatically with
// `isSystem=true` (not deletable; can be disabled via `enabled`).
//
// Backend-only: service-role, RLS without policies.

enum PaymentMethodType {
  mp_transfer
  cash
  other

  @@map("payment_method_type")
}

model PaymentMethod {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type      PaymentMethodType
  name      String
  enabled   Boolean           @default(true)
  isSystem  Boolean           @default(false) @map("is_system")
  isDefault Boolean           @default(false) @map("is_default")
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, type])
  @@index([companyId])
  @@map("payment_methods")
}
