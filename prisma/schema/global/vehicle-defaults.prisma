/// Plantillas de la plataforma para sembrar cuentas NUEVAS.
///
/// NO se exponen por la API del tenant y no tienen pantalla de admin: se editan
/// por migración. Las lee únicamente la función `bootstrap_tenant_defaults()`,
/// disparada por el trigger `AFTER INSERT ON tenants`.
///
/// Su razón de ser: el modelo "cada estacionamiento tiene su copia" iba a
/// perder el catálogo semilla de la plataforma. Con la plantilla, si sale un
/// modelo nuevo se agrega acá y las cuentas nuevas nacen con él, pero las playas
/// existentes no se tocan — que es exactamente lo buscado.
///
/// Se modelan en Prisma aunque ningún service las use: el repo mantiene 1:1
/// entre tablas SQL y modelos Prisma, y romperlo hace ruidoso el `db:diff`.
model VehicleTypeDefault {
  name     String  @id @db.VarChar(60)
  accepted Boolean @default(true)

  /// Categoría de la plataforma con la que nace el tipo (migración
  /// 20261005120000). El trigger de alta de cuentas la copia a `vehicle_types`.
  category    String          @db.VarChar(20)
  categoryRef VehicleCategory @relation(fields: [category], references: [code], onUpdate: Cascade)

  catalogDefaults VehicleCatalogDefault[]

  @@map("vehicle_type_defaults")
}

/// Plantilla del catálogo: los modelos con los que nace cada cuenta nueva.
///
/// Sin `id`: la PK es (brand, model) y cada tenant genera los suyos al copiar.
/// Eso elimina el aparato de UUIDv5 determinísticos que necesitaba el catálogo
/// global, donde los ids eran compartidos por todas las playas.
model VehicleCatalogDefault {
  brand String @db.VarChar(120)
  model String @db.VarChar(120)

  /// Nombre del tipo por defecto. FK a `vehicle_type_defaults.name` para que
  /// el generador no pueda emitir un tipo inexistente.
  typeName    String             @map("type_name") @db.VarChar(60)
  defaultType VehicleTypeDefault @relation(fields: [typeName], references: [name], onUpdate: Cascade)

  @@id([brand, model])
  @@map("vehicle_catalog_defaults")
}
