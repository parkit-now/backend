// Tenant — one row per parking lot (the "entity" users are attached to).
//
// "Tenant" is the multi-tenancy primitive (used by RLS, the `/tenants/:id`
// routes and `prismaForTenant`) and is also the business entity: there is no
// company grouping above it. Access is direct user↔entity via UserMembership:
//   - an owner can hold several tenants (one per lot they run);
//   - an operator can be linked to several tenants (one per lot they work in).
//
// Legal/contact fields (legalName, cuit, email, phone) live here now; they used
// to live on the removed `Company`. `cuit` is not unique: several lots may share
// the same legal entity.
//
// Backend-only: writes/reads happen via the service-role connection. RLS is
// enabled but no policies are declared, so no anon/authenticated role can
// touch this table.

/// OJO: un INSERT en `tenants` dispara `bootstrap_tenant_defaults()`
/// (trigger AFTER INSERT, migración 20260901013345), que siembra los siete
/// tipos de vehículo, el catálogo de 244 modelos, el servicio de reserva
/// anticipada y los dos métodos de pago del sistema. Está en la base y no en
/// NestJS porque hay tres caminos de alta de tenants y ya habían divergido.
model Tenant {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  legalName String?      @map("legal_name")
  cuit      String?
  email     String?      @db.VarChar(255)
  phone     String?
  /// Dirección completa en una línea, para mostrar. Guarda la `nomenclatura`
  /// que devuelve la API Georef. Es el campo de display y el que mantiene la
  /// retrocompatibilidad; los datos para Mercado Pago viven en las columnas
  /// separadas de abajo.
  address   String?
  status    BranchStatus @default(active)
  settings  Json         @default("{}")
  // Owner-configurable retention for `registered` LPR detection images
  // (days after the stay exit). One of 30/60/90 by a DB CHECK; default 30.
  lprImageRetentionDays Int @default(30) @map("lpr_image_retention_days") @db.SmallInt

  // Cámara de ingreso. Solo la IDENTIDAD: la URL RTSP y la contraseña viven en
  // el equipo (una IP de LAN no sirve fuera de la playa y la credencial no gana
  // nada viajando a la nube). Ver 20260921030000_tenant_entry_camera.sql.
  entryCameraId    String? @map("entry_camera_id") @db.VarChar(100)
  entryCameraLabel String? @map("entry_camera_label") @db.VarChar(120)

  // Dirección estructurada (migración 20260913164617). Mercado Pago necesita
  // la ubicación del `Store` con los campos SEPARADOS; una ubicación mal
  // cargada le rompe el cálculo de impuestos al dueño. Todas nullable: no
  // hacen falta para existir como tenant, la obligatoriedad la valida el
  // service recién al vincular Mercado Pago. El backend NO geocodifica: el
  // front normaliza contra la API Georef del Estado y manda esto ya separado.
  /// Nombre de la calle, sin altura.
  streetName   String? @map("street_name")
  /// Altura, como TEXTO y no entero a propósito: existen "S/N", "1234 bis" y
  /// "Km 5". Mercado Pago también lo recibe como string. No convertir a Int.
  streetNumber String? @map("street_number")
  /// Piso y/o departamento. Sólo contacto/facturación; Mercado Pago no lo usa.
  floor        String?
  cityName     String? @map("city_name")
  stateName    String? @map("state_name")
  postalCode   String? @map("postal_code")
  /// Latitud en grados decimales. Sólo válida junto con `longitude`: el CHECK
  /// `tenants_coordinates_paired` prohíbe media coordenada.
  latitude     Decimal? @db.Decimal(9, 6)
  /// Longitud en grados decimales. Ver `latitude`.
  longitude    Decimal? @db.Decimal(9, 6)
  /// Origen del dato: `georef` (normalizado por la API del Estado) o `manual`.
  /// Conjunto cerrado por el CHECK `tenants_geocoding_source_valid`.
  geocodingSource String? @map("geocoding_source") @db.VarChar(16)
  geocodedAt      DateTime? @map("geocoded_at") @db.Timestamptz(6)

  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  memberships          UserMembership[]
  entries              Entry[]
  rates                Rate[]
  schedules            Schedule[]
  services             Service[]
  paymentMethods       PaymentMethod[]
  vehicles             Vehicle[]
  vehicleTypes         VehicleType[]
  auditLogs            AuditLog[]
  applications         OnboardingApplication[]
  cashSessions         CashSession[]
  paymentTransactions  PaymentTransaction[]
  whitelists           Whitelist[]
  lprDetectionEvents   LprDetectionEvent[]
  // Mercado Pago (global/mercado-pago.prisma). La cuenta es 0..1 por el
  // `@unique` sobre `MpAccount.tenantId`: una playa vincula a lo sumo una.
  mpAccount            MpAccount?
  mpOauthStates        MpOauthState[]
  // Intentos de cobro con QR (global/payment-intents.prisma).
  paymentIntents       PaymentIntent[]

  // `@unique` sobre `ArcaAccount.tenantId`: una playa vincula a lo sumo una.
  arcaAccount          ArcaAccount?
  arcaRequests         ArcaRequest[]
  invoiceReceivers     InvoiceReceiver[]
  invoices             Invoice[]

  @@index([cuit])
  @@map("tenants")
}

enum BranchStatus {
  active
  maintenance

  @@map("branch_status")
}
