// Tenant — one row per parking lot.
//
// "Tenant" is kept as the multi-tenancy primitive (used by RLS, the JWT
// `app_metadata.tenant_id`, and `prismaForTenant`), but the business meaning
// is 1:1 with a parking lot:
//   - an owner can hold several tenants (one per lot they run);
//   - an operator can be linked to several tenants (one per lot they work in).
//
// Backend-only: writes/reads happen via the service-role connection. RLS is
// enabled but no policies are declared, so no anon/authenticated role can
// touch this table.

model Tenant {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  address   String?
  status    BranchStatus @default(active)
  settings  Json         @default("{}")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  // Each tenant (parking lot / branch) belongs to a Company.
  // Nullable to keep legacy/demo tenants without a company working.
  companyId String?  @map("company_id") @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  memberships UserMembership[]
  entries     Entry[]
  zones       Zone[]

  @@index([companyId])
  @@map("tenants")
}

enum BranchStatus {
  active
  maintenance

  @@map("branch_status")
}
