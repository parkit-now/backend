// ARCA (ex AFIP) — cuenta de facturación electrónica de cada playa, tickets
// del WSAA y auditoría de llamadas. Migración 20260924235900_arca_invoicing.sql.
//
// Globales aunque tengan `tenantId`, igual que `MpAccount`: el job de
// mantenimiento las barre cross-tenant y no llevan `syncSeq`. NINGUNA va en
// `TENANT_MODELS`: el service filtra a mano por el `:tenantId` de la ruta.
// Backend-only: RLS prendida y cero policies.

enum ArcaEnvironment {
  homologacion
  produccion

  @@map("arca_environment")
}

enum ArcaAccountStatus {
  pending_certificate
  pending_sales_point
  linked
  cert_expired
  unlinked

  @@map("arca_account_status")
}

/// Condición frente al IVA del EMISOR: decide la letra del comprobante.
enum ArcaTaxCondition {
  responsable_inscripto
  monotributo
  exento

  @@map("arca_tax_condition")
}

/// Cuenta ARCA de una playa, con SU PROPIO certificado (sin delegación).
model ArcaAccount {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  tenantId String @unique @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  environment ArcaEnvironment
  status      ArcaAccountStatus @default(pending_certificate)

  cuit                 String            @db.VarChar(11)
  iibb                 String?           @db.VarChar(30)
  razonSocial          String?           @map("razon_social")
  condicionIva         ArcaTaxCondition? @map("condicion_iva")
  domicilioFiscal      String?           @map("domicilio_fiscal")
  inicioActividad      DateTime?         @map("inicio_actividad") @db.Date
  ptoVta               Int?              @map("pto_vta")
  ivaRate              Decimal           @default(21) @map("iva_rate") @db.Decimal(5, 2)

  csrPem          String?   @map("csr_pem")
  certPem         String?   @map("cert_pem")
  /// CIFRADA con `ARCA_KEY_ENCRYPTION_KEY` (AES-256-GCM). Nunca en plano.
  keyEncrypted    String?   @map("key_encrypted")
  keyVersion      Int?      @map("key_version") @db.SmallInt
  /// SHA-256 del certificado en hex: la clave de `ArcaAccessTicket`.
  certFingerprint String?   @map("cert_fingerprint") @db.VarChar(64)
  certExpiresAt   DateTime? @map("cert_expires_at") @db.Timestamptz(6)

  renewalCsrPem       String?   @map("renewal_csr_pem")
  renewalKeyEncrypted String?   @map("renewal_key_encrypted")
  renewalKeyVersion   Int?      @map("renewal_key_version") @db.SmallInt
  renewalPreparedAt   DateTime? @map("renewal_prepared_at") @db.Timestamptz(6)

  linkedAt  DateTime? @map("linked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  // `arca_accounts_cert_expiry_idx` es parcial (WHERE status = 'linked'): vive
  // sólo en SQL.
  @@map("arca_accounts")
}

/// Ticket de Acceso del WSAA (~12 h), compartido por todas las playas que usan
/// el mismo certificado.
model ArcaAccessTicket {
  certFingerprint      String          @map("cert_fingerprint") @db.VarChar(64)
  service              String          @db.VarChar(64)
  environment          ArcaEnvironment
  /// `ILoginCredentials` del SDK en JSON, cifrado con `ARCA_KEY_ENCRYPTION_KEY`.
  credentialsEncrypted String          @map("credentials_encrypted")
  keyVersion           Int             @map("key_version") @db.SmallInt
  expiresAt            DateTime        @map("expires_at") @db.Timestamptz(6)
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([certFingerprint, service, environment])
  @@map("arca_access_tickets")
}

/// Auditoría de cada llamada a ARCA: request, respuesta y cuánto tardó.
model ArcaRequest {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  invoiceId String?  @map("invoice_id") @db.Uuid
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  operation    String   @db.VarChar(40)
  requestJson  Json?    @map("request_json")
  responseJson Json?    @map("response_json")
  error        String?
  durationMs   Int      @map("duration_ms")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, createdAt], map: "arca_requests_tenant_created_idx")
  @@index([invoiceId], map: "arca_requests_invoice_idx")
  @@map("arca_requests")
}

// Receptores con CUIT: caché del padrón y sugerencias del cobro (Etapa 5).
// Migración 20260926150000_invoice_receivers.sql.
model InvoiceReceiver {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  cuit                   String    @db.VarChar(11)
  razonSocial            String?   @map("razon_social")
  /// `CondicionIVAReceptorId` según el padrón. `null` = ARCA no tiene datos.
  condicionIvaReceptorId Int?      @map("condicion_iva_receptor_id") @db.SmallInt
  fetchedAt              DateTime  @map("fetched_at") @db.Timestamptz(6)
  lastUsedAt             DateTime? @map("last_used_at") @db.Timestamptz(6)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  // `invoice_receivers_tenant_used_idx` (parcial) vive sólo en SQL.
  @@unique([tenantId, cuit], map: "invoice_receivers_tenant_cuit_key")
  @@map("invoice_receivers")
}
