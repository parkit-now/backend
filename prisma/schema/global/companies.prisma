// Company — the company / legal entity that owns one or more lots (tenants).
//
// Introduced for the onboarding flow: legal name and CUIT live here (they were
// removed from `tenants` in 20260505200000_drop_tenants_cuit.sql). A company
// groups N tenants (branches). `status` governs the owner's access.
//
// Backend-only: service-role, RLS without policies (same as Tenant).

enum CompanyStatus {
  pending
  active
  suspended

  @@map("company_status")
}

model Company {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  legalName String        @map("legal_name")
  cuit      String        @unique
  email     String        @db.VarChar(255)
  phone     String?
  address   String?
  status    CompanyStatus @default(pending)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  ownerUserId String @map("owner_user_id") @db.Uuid
  owner       User   @relation(fields: [ownerUserId], references: [id])

  tenants        Tenant[]
  applications   OnboardingApplication[]
  documents      CompanyDocument[]
  paymentMethods PaymentMethod[]
  auditLogs      AuditLog[]

  @@index([ownerUserId])
  @@map("companies")
}
