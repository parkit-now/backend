model Vehicle {
  // UUIDv7 is generated by the desktop client to support offline-first writes.
  id          String   @id @db.Uuid
  brand       String
  model       String
  type        String?
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  entries     Entry[]

  @@map("vehicles")
}
