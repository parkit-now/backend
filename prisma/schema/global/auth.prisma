// Auth: roles and users for the web/desktop/mobile platform.
// User.id is assigned by Supabase Auth — no @default here.
//
// The GLOBAL role is platform-level only: `admin` (sees/manages everything) or
// `user` (everyone else). It is NOT where "owner"/"operator" live — those are
// per-entity and live on `UserMembership.role` (see memberships.prisma). So a
// single user can be owner of one lot and operator of another. A `user` with no
// memberships is just an end user (e.g. a mobile-app driver).
//
// The entity acted on per request is resolved from `/tenants/:tenantId` and
// `TenantMembershipGuard`; it is NOT carried in the JWT. The JWT only carries
// the global `role` (see custom_access_token_hook).

enum UserRole {
  admin // platform-level, sees/manages every entity
  user  // everyone else; entity-level role comes from UserMembership

  @@map("user_role")
}

model User {
  id        String   @id @db.Uuid
  role      UserRole
  email     String   @unique @db.VarChar(255)
  // Display name mirrored from Supabase Auth metadata (full_name/name).
  // Nullable: email/password sign-ups may not carry a name.
  name      String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  memberships UserMembership[]

  // Onboarding (back-relations).
  applications         OnboardingApplication[] @relation("ApplicantApplications")
  reviewedApplications OnboardingApplication[] @relation("ReviewedApplications")
  auditLogs            AuditLog[]
  reviewedLprDetectionEvents LprDetectionEvent[]
  archivedLprDetectionEvents LprDetectionEvent[] @relation("ArchivedLprDetectionEvents")
  // Flujos de vinculación de Mercado Pago que inició esta persona
  // (global/mercado-pago.prisma).
  mpOauthStates              MpOauthState[]
  // Intentos de cobro con QR que mandó a generar esta persona
  // (global/payment-intents.prisma). Back-relation de `createdByUserId`, que es
  // `SET NULL` al borrar: el historial de cobros sobrevive al empleado.
  createdPaymentIntents      PaymentIntent[]
  // Reservas que hizo como conductor (tenant/reservations.prisma).
  reservations               Reservation[]
  // Reservas que canceló o rechazó (como conductor, dueño u operador).
  cancelledReservations      Reservation[] @relation("ReservationCancelledBy")
  // Vehículos que cargó como conductor (global/driver-vehicles.prisma).
  driverVehicles             DriverVehicle[]
  // Estacionamientos que dio de baja como admin global
  // (global/tenants.prisma). `SET NULL` al borrar: la baja sobrevive al admin.
  deletedTenants             Tenant[] @relation("TenantDeletedBy")

  @@map("users")
}
