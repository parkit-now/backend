// Auth: roles and users for the web/desktop/mobile platform.
// User.id is assigned by Supabase Auth — no @default here.
//
// The GLOBAL role is platform-level only: `admin` (sees/manages everything) or
// `user` (everyone else). It is NOT where "owner"/"operator" live — those are
// per-entity and live on `UserMembership.role` (see memberships.prisma). So a
// single user can be owner of one lot and operator of another. A `user` with no
// memberships is just an end user (e.g. a mobile-app driver).
//
// The entity acted on per request is resolved from `/tenants/:tenantId` and
// `TenantMembershipGuard`; it is NOT carried in the JWT. The JWT only carries
// the global `role` (see custom_access_token_hook).

enum UserRole {
  admin // platform-level, sees/manages every entity
  user  // everyone else; entity-level role comes from UserMembership

  @@map("user_role")
}

model User {
  id        String   @id @db.Uuid
  role      UserRole
  email     String   @unique @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  memberships UserMembership[]

  // Onboarding (back-relations).
  applications         OnboardingApplication[] @relation("ApplicantApplications")
  reviewedApplications OnboardingApplication[] @relation("ReviewedApplications")
  auditLogs            AuditLog[]

  @@map("users")
}
