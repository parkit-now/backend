{
  "name": "parkit-backend",
  "version": "0.1.0",
  "description": "Parkit backend API",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "postinstall": "prisma generate",
    "build": "prisma generate && nest build",
    "typecheck": "prisma generate && tsc --noEmit",
    "start": "bun dist/main.js",
    "start:dev": "bun --hot run src/main.ts",
    "start:debug": "bun --inspect --hot run src/main.ts",
    "start:prod": "bun run dist/main.js",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "lint:check": "eslint \"src/**/*.ts\"",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "db:generate": "prisma generate",
    "db:reset": "supabase db reset",
    "seed:auth": "bun run scripts/seed-auth.ts",
    "seed:tenant": "bun run scripts/seed-tenant.ts",
    "seed:all": "bun run scripts/seed-auth.ts && bun run scripts/seed-tenant.ts",
    "db:diff": "supabase db diff -f",
    "db:push": "bash -c 'set -a; . ./.env; set +a; supabase db push --db-url \"$DIRECT_URL\"'",
    "studio": "prisma studio"
  },
  "prisma": {
    "schema": "prisma/schema"
  },
  "dependencies": {
    "@arcasdk/core": "2.0.2",
    "@arcasdk/pdf": "^0.2.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.2",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@supabase/supabase-js": "^2.45.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "jose": "^5.9.0",
    "node-forge": "^1.3.1",
    "nodemailer": "^8.0.7",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bun": "^1.3.13",
    "@types/express": "^5.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.7",
    "@types/node-forge": "^1.3.14",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.11.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "prettier": "^3.4.2",
    "prisma": "^7.8.0",
    "prisma-generator-nestjs-dto": "^1.1.4",
    "ts-loader": "^9.5.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
