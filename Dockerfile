# syntax=docker/dockerfile:1.7

# ---------- Builder ----------
FROM oven/bun:1.2-debian AS builder

WORKDIR /app

# Bring lockfile + manifests first to maximize layer caching.
COPY package.json bun.lock* ./
COPY prisma ./prisma
COPY prisma.config.ts ./

# `bun install` runs `prisma generate` via postinstall and emits the
# Prisma client into node_modules — keeps the runner image self-contained.
RUN bun install --frozen-lockfile

COPY tsconfig.json tsconfig.build.json nest-cli.json ./
COPY src ./src

RUN bun run build

# ---------- Runner ----------
FROM oven/bun:1.2-debian AS runner

WORKDIR /app

# Prisma needs libssl at runtime. Install once and clean the apt cache.
# The ARCA invoice PDFs are drawn by the desktop app, not here.
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production
# PORT is set by Cloud Run - do not override it

COPY package.json bun.lock* ./

# --ignore-scripts skips the `prisma generate` postinstall here — the client
# was already generated in the builder stage and is copied below.
RUN bun install --frozen-lockfile --production --ignore-scripts

# Prisma client generated by the builder (devDep generators not needed at runtime).
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma

COPY --from=builder /app/dist ./dist

# Do not EXPOSE port - Cloud Run assigns it dynamically

# Migrations are applied out-of-band by `supabase db push --linked` in CI.
# The container only runs the API.
CMD ["bun", "run", "start"]
